# Example environment configuration for the Drone Pad API Service
# Copy this file to .env and modify as needed.
# All values shown are the defaults.

# --- Server ---
DRONE_PAD_HOST=0.0.0.0
DRONE_PAD_PORT=8000
DRONE_PAD_LOG_LEVEL=INFO

# --- Simulation Mode ---
# Set to "true" to run without GPIO hardware (for development/testing)
DRONE_PAD_SIMULATION=false

# --- GPIO Pin Assignments (BCM numbering) ---
# Opening Motor (NEMA 23)
DRONE_PAD_OPENING_STEP_PIN=14
DRONE_PAD_OPENING_DIR_PIN=16
DRONE_PAD_OPENING_ENABLE_PIN=12
# DIR wiring on this driver is reversed relative to FORWARD/REVERSE — invert in software
DRONE_PAD_OPENING_DIR_INVERTED=true

# Lift Motor (NEMA 17)
DRONE_PAD_LIFT_STEP_PIN=26
DRONE_PAD_LIFT_DIR_PIN=13
DRONE_PAD_LIFT_ENABLE_PIN=11

# Limit Switches
DRONE_PAD_OPEN_LIMIT_PIN=4
DRONE_PAD_CLOSE_LIMIT_PIN=10
DRONE_PAD_LIFT_UPPER_PIN=9
DRONE_PAD_LIFT_LOWER_PIN=3

# --- Motor Parameters ---
# Step delay in microseconds (lower = faster)
DRONE_PAD_OPENING_STEP_DELAY_US=500
DRONE_PAD_LIFT_STEP_DELAY_US=800

# Operation timeout in seconds (watchdog)
DRONE_PAD_OPENING_TIMEOUT_S=60.0
DRONE_PAD_LIFT_TIMEOUT_S=30.0

# Enable pin polarity (true = active LOW, which is standard for most drivers)
DRONE_PAD_OPENING_ENABLE_ACTIVE_LOW=true
DRONE_PAD_LIFT_ENABLE_ACTIVE_LOW=true

# --- Limit Switch Parameters ---
# Debounce time in milliseconds
DRONE_PAD_SWITCH_DEBOUNCE_MS=50

# Switch polarity (true = switch pulls pin LOW when triggered)
DRONE_PAD_SWITCH_ACTIVE_LOW=true

# --- Docking System (BLE, ESP32 dock-lock controller) ---
# BLE MAC address of the ESP32 (read from its serial boot log: "[BLE] MAC Address: ...")
DRONE_PAD_DOCK_MAC=70:4B:CA:7B:AF:A2
DRONE_PAD_DOCK_SERVICE_UUID=4fafc201-1fb5-459e-8fcc-c5c9c331914b
DRONE_PAD_DOCK_CMD_UUID=beb5483e-36e1-4688-b7f5-ea07361b26a8
DRONE_PAD_DOCK_STATUS_UUID=8c1c10ea-4536-4a5b-9c37-2f7a3e5c1d2b
DRONE_PAD_DOCK_DEVICE_NAME=DockController

# BLE connect timeout, and max time to wait for a *_COMPLETE/ERROR status
DRONE_PAD_DOCK_CONNECT_TIMEOUT_S=10.0
DRONE_PAD_DOCK_COMMAND_TIMEOUT_S=45.0
